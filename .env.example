# ==============================================================================
# purpleGPT - Configurazione Variabili d'Ambiente (.env.example)
# ==============================================================================
# Rinominare questo file in '.env' e compilare i valori necessari prima dell'avvio.
# ATTENZIONE: Non condividere o pubblicare mai il file '.env' reale con chiavi e token!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Configurazione Google Cloud / Vertex AI
# ------------------------------------------------------------------------------
# ID del progetto Google Cloud abilitato per Vertex AI e credenziali di servizio
PROJECT_ID='tuo-progetto-gcp-id'
LOCATION='tua-location'

# ------------------------------------------------------------------------------
# 2. Configurazione Discord Bot
# ------------------------------------------------------------------------------
# Token di autenticazione del bot ottenuto dal Discord Developer Portal
TOKEN='IL_TUO_DISCORD_BOT_TOKEN_QUI'

# Webhook Discord dedicato alla ricezione delle segnalazioni di bug inviate dagli utenti con /bug
BUG_WEBHOOK_URL='https://discord.com/api/webhooks/000000000000000000/IL_TUO_WEBHOOK_TOKEN_QUI'

# ------------------------------------------------------------------------------
# 3. Database Locale SQLite
# ------------------------------------------------------------------------------
# Percorso relativo o assoluto al database SQLite di purpleGPT
DB_PATH='database.db'

# ------------------------------------------------------------------------------
# 4. Configurazione Dashboard Web (Flask)
# ------------------------------------------------------------------------------
# Credenziali di accesso al pannello web di amministrazione
DASHBOARD_USER='admin'
DASHBOARD_PASS='CambiamiSubito123!'

# Chiave segreta per la firma sicura delle sessioni e cookie Flask (usare una stringa casuale)
DASHBOARD_SECRET_KEY='genera_una_stringa_segreta_molto_lunga_e_casuale_qui'

# Token Bearer condiviso per l'API interna tra la Dashboard e il Bot (per broadcast e sync server)
BROADCAST_SECRET='genera_un_token_segreto_per_comunicazione_interna_qui'

# Cookie di sessione: 'true' per produzione (richiede HTTPS), 'false' solo per test locali su http://localhost
SESSION_COOKIE_SECURE='true'

# ------------------------------------------------------------------------------
# 5. Monetizzazione Discord (Opzionale / Monetization SKU)
# ------------------------------------------------------------------------------
# SKU ID forniti da Discord Developer Portal se abilitata la monetizzazione per abbonamenti
DISCORD_SKU_STARTER='000000000000000000'
DISCORD_SKU_PRO='000000000000000000'

# ------------------------------------------------------------------------------
# 6. Modelli AI (Opzionali - Valori predefiniti)
# ------------------------------------------------------------------------------
CHAT_MODEL='gemini-3.8-flash'
IMAGE_MODEL='gemini-3.1-flash-image'
MUSIC_MODEL='lyria-3-clip-preview'
